{
  "name": "tagix",
  "private": false,
  "version": "1.2.2",
  "type": "module",
  "description": "A state management library for TypeScript built on functional programming primitives.",
  "keywords": [
    "tagix",
    "state-management",
    "typescript",
    "functional-programming",
    "tagged-unions",
    "pattern-matching",
    "type-safe",
    "state-machine",
    "immutable",
    "discriminated-unions",
    "exhaustive-matching",
    "type-inference",
    "async-actions",
    "middleware",
    "selectors",
    "error-handling",
    "context"
  ],
  "author": "Chris M. Pérez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrismichaelps/tagix.git"
  },
  "bugs": {
    "url": "https://github.com/chrismichaelps/tagix/issues"
  },
  "homepage": "https://github.com/chrismichaelps/tagix#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "tsup.config.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    }
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:prod": "tsup --minify",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.17",
    "@vue/test-utils": "^2.4.11",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "multi-semantic-release": "^3.1.0",
    "prettier": "^3.8.1",
    "react": "^19.2.7",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.38"
  },
  "packageManager": "pnpm@10.30.0"
}
